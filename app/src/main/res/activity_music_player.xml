<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <!-- عنوان الشاشة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 مكتبة ومشغل الموسيقى"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <!-- عرض اسم الملف الحالي قيد التشغيل -->
    <TextView
        android:id="@+id/txtSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اختر مقطعاً صوتياً للبدء..."
        android:textSize="16sp"
        android:textColor="#FF9800"
        android:gravity="center"
        android:layout_marginBottom="15dp"/>

    <!-- شريط التقدم (SeekBar) -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>

    <!-- أزرار التحكم (السابق، تشغيل/إيقاف، التالي) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="25dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏮ السابق"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ تشغيل"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="10dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التالي ⏭"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- قائمة عرض جميع الملفات الصوتية في الهاتف -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="قائمة الملفات الصوتية:"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="5dp"/>

    <ListView
        android:id="@+id/songListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#222222"
        android:dividerHeight="1dp"/>

</LinearLayout>
